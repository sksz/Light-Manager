<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <!--
        Dwie grupy od kroku 38. `unit` sprawdza klasy, `functional` — przebiegi
        użytkownika: sekwencje klawiszy przez `ScreenFixture` (a przy starcie
        i zmianie rozmiaru przez `GameLoop` ze `ScriptedTerminal`), z asercjami
        w punktach kontrolnych.

        Granica jest tu **po to, żeby dało się ją wywołać osobno** — krok 39
        opiera na niej cele `test-unit` i `test-functional`. Domyślne
        uruchomienie bez argumentów robi jedno i drugie.

        Od kroku 66 grupy są **trzy**. `documentation` sprawdza, czy dokumentacja
        nie kłamie: spisy wobec rejestrów, klawisze wobec wiązań, odnośniki wobec
        plików, para językowa wobec samej siebie. Stoi osobno, bo pyta o co
        innego niż dwie pozostałe — o **tekst**, a nie o aplikację — i dlatego
        opłaca się umieć wywołać ją samą (`make docs-check`) w sekundę zamiast
        czekać na pełny przebieg.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests</directory>
            <exclude>tests/Functional</exclude>
            <exclude>tests/Documentation</exclude>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
        <testsuite name="documentation">
            <directory>tests/Documentation</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
