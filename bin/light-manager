#!/usr/bin/env php
<?php

declare(strict_types=1);

use LightManager\Domain\Exception\DomainException;
use LightManager\Infrastructure\I18n\TranslatorService;
use LightManager\Infrastructure\Support\InfrastructureException;
use LightManager\Presentation\Cli\Bootstrap;

$autoload = __DIR__ . '/../vendor/autoload.php';

// Jedyny napis w całej aplikacji, który nie może przejść przez katalog: bez
// autoloadera nie ma jeszcze ani tłumacza, ani czym go wczytać.
if (!is_file($autoload)) {
    fwrite(STDERR, 'Composer dependencies are missing. Run: composer install' . PHP_EOL);

    exit(1);
}

require $autoload;

if (!extension_loaded('imagick')) {
    fwrite(STDERR, TranslatorService::getInstance()->translate('problem.missingImagick') . PHP_EOL);

    exit(1);
}

// Tryb okienkowy wybiera się flagą, zanim cokolwiek dotknie terminala (krok 34,
// D53) — dzięki temu tor okienkowy nie wysyła na STDOUT ani jednej sekwencji.
$windowed = in_array('--window', array_slice($argv, 1), true);

// Preflight wzorem `imagick`, ale wyłącznie pod flagą: tryby terminalowe mają
// działać bez rozszerzenia `glfw`, więc bez flagi nie ma żadnego wymogu.
if ($windowed && !extension_loaded('glfw')) {
    fwrite(STDERR, TranslatorService::getInstance()->translate('problem.missingGlfw') . PHP_EOL);

    exit(1);
}

try {
    Bootstrap::boot($windowed);
    Bootstrap::createGameLoop()->run();
} catch (InfrastructureException|DomainException $exception) {
    // Bez sprzątania w tym miejscu: gdy zawiódł sam bootstrap, usługa terminala
    // może nie istnieć, a próba jej pobrania rzuciłaby ten sam wyjątek raz
    // jeszcze — tym razem już nieprzechwycony. Gdy istnieje, terminal przywróci
    // zarejestrowana przez nią funkcja zamknięcia procesu.
    fwrite(STDERR, Bootstrap::problemPresenter()->startupText($exception) . PHP_EOL);

    exit(1);
}

Bootstrap::shutdown();
